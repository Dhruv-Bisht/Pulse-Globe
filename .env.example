# AWS
AWS_REGION=ap-south-1

# DynamoDB table
DYNAMODB_TABLE=PulseGlobeNews

# Secret used ONLY by private POST/DELETE API calls and scripts.
# Never prefix this with NEXT_PUBLIC_.
API_SECRET=replace-with-a-long-random-secret

# Optional: show clearly-labelled demo stories when DynamoDB is empty/unavailable.
DEMO_MODE=true

# Optional script target
PULSE_GLOBE_URL=http://localhost:3000