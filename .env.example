# AWS region your DynamoDB table lives in
AWS_REGION=us-east-1

# DynamoDB table name (create this table before running the app — see README)
DYNAMODB_TABLE=PulseNews

# Shared secret required in the `x-api-key` header to POST or DELETE news.
# Generate one yourself, e.g.: openssl rand -hex 32
API_SECRET=replace-with-a-long-random-string

# Only needed locally if you're not using an IAM role / `aws configure` profile.
# On EC2/App Runner/Amplify with an attached IAM role, leave these unset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Only needed if you use scripts/generate-ai-news.js to draft items with Claude.
# ANTHROPIC_API_KEY=
